<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
  <plugin
    filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics">
  </plugin>
  <plugin
    filename="gz-sim-user-commands-system"
    name="gz::sim::systems::UserCommands">
  </plugin>
  <plugin
    filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster">
  </plugin>
  <plugin
    filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin
    filename="gz-sim-imu-system"
    name="gz::sim::systems::Imu">
  </plugin>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>1.0 0.55 6.0 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ================================================================== -->
    <!-- 1.5x-WIDE GATES (same exact S-curve gates as obstacle_course.world) -->
    <!-- ================================================================== -->

    <!-- Gate 1 (Orange): Turn 1 apex at (0.819, 0.105) -->
    <model name="gate1_inner">
      <static>true</static>
      <pose>0.686 0.299 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.1 1</ambient><diffuse>0.9 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gate1_outer">
      <static>true</static>
      <pose>0.952 -0.089 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry>
          <material><ambient>0.9 0.35 0.1 1</ambient><diffuse>0.9 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gate 2 (Blue): Turn 2 apex at (1.434, 1.108) -->
    <model name="gate2_inner">
      <static>true</static>
      <pose>1.566 0.914 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gate2_outer">
      <static>true</static>
      <pose>1.301 1.302 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.50</length></cylinder></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- JUNK / DECOY OBSTACLES (gray/green/yellow clutter around the path) -->
    <!-- Includes TurtleBot-turret-sized decoys (r=0.055m), boxes, and walls -->
    <!-- ================================================================== -->

    <!-- Decoys flanking the spawn and first straightaway -->
    <model name="junk_decoy_1">
      <static>true</static>
      <pose>-0.40 0.42 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_2">
      <static>true</static>
      <pose>-0.60 -0.40 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_3">
      <static>true</static>
      <pose>0.18 0.38 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.35 1</ambient><diffuse>0.2 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_box_1">
      <static>true</static>
      <pose>0.25 -0.45 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 0.18 0.30</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.30</size></box></geometry>
          <material><ambient>0.75 0.65 0.2 1</ambient><diffuse>0.75 0.65 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Clutter around Turn 1 (inside and outside the arc) -->
    <model name="junk_box_2">
      <static>true</static>
      <pose>0.25 0.85 0.20 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.24 0.16 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.24 0.16 0.40</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_4">
      <static>true</static>
      <pose>1.32 -0.30 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.35 1</ambient><diffuse>0.2 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_5">
      <static>true</static>
      <pose>1.42 0.18 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Clutter flanking Straight 2 -->
    <model name="junk_decoy_6">
      <static>true</static>
      <pose>0.68 0.80 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.75 0.65 0.2 1</ambient><diffuse>0.75 0.65 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_box_3">
      <static>true</static>
      <pose>0.78 1.22 0.20 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.22 0.14 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.22 0.14 0.40</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_7">
      <static>true</static>
      <pose>1.55 0.48 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.35 1</ambient><diffuse>0.2 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Clutter around Turn 2 and final straightaway -->
    <model name="junk_decoy_8">
      <static>true</static>
      <pose>1.98 0.62 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_9">
      <static>true</static>
      <pose>2.05 1.62 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.35 1</ambient><diffuse>0.2 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_box_4">
      <static>true</static>
      <pose>2.28 0.80 0.15 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 0.16 0.30</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.16 0.30</size></box></geometry>
          <material><ambient>0.75 0.65 0.2 1</ambient><diffuse>0.75 0.65 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_decoy_10">
      <static>true</static>
      <pose>2.62 1.60 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Angled walls / corridor clutter in the background -->
    <model name="junk_wall_south">
      <static>true</static>
      <pose>0.60 -0.85 0.20 0 0 0.1</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.40 0.08 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.40 0.08 0.40</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="junk_wall_finish">
      <static>true</static>
      <pose>3.25 1.21 0.20 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.20 0.08 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.20 0.08 0.40</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>
